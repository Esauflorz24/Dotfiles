# blerc

bleopt default_keymap=vi
bleopt exec_errexit_mark=
bleopt keymap_vi_mode_show:=
bleopt exec_errexit_mark=
bleopt exec_exit_mark=
bleopt complete_auto_delay=300
bleopt complete_ambiguous=

ble-face auto_complete='fg=240,italic'
ble-face command_builtin='fg=255'
ble-face syntax_error='fg=000,bg=255'
ble-face command_alias='fg=255,underline'
ble-face filename_directory='fg=245,underline,italic'
ble-face command_file='fg=250,bold'


ble-bind -m vi_nmap --cursor 2
ble-bind -m vi_imap --cursor 5
ble-bind -m vi_omap --cursor 4
ble-bind -m vi_xmap --cursor 2
ble-bind -m vi_cmap --cursor 0


source /usr/share/bash-completion/bash_completion 
ble-import -d integration/fzf-completion
ble-import -d integration/fzf-key-bindings
